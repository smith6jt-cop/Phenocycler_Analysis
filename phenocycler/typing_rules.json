{
  "schema_version": 1,
  "rules_version": "hierarchical-typing-rules-v1",
  "marker_registry_version": "marker-calibration-registry-v1",
  "description": "Curated biological interpretation layered over the marker calibration registry. Broad models are simultaneous; subtypes are interpreted only inside an accepted parent.",
