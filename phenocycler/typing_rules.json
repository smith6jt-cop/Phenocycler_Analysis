      "support": ["Ker8_18", "Keratin_5", "EpCAM"],
      "exclusions": ["CD31"]
    },
    "Neural": {
      "anchors": ["B3TUBB"],
      "support": [],
      "exclusions": ["E_cadherin"]
    },
    "Mesenchymal": {
      "anchors": ["Vimentin", "SMA"],
      "support": [],
      "exclusions": ["E_cadherin", "CD31", "CD3e"]
    }
  },
